<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Center"/>
   <Borders/>
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="11" ss:Color="#1E293B"/>
   <Interior/>
   <NumberFormat/>
   <Protection/>
  </Style>
  <Style ss:ID="HeaderStyle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
   </Borders>
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="11" ss:Color="#FFFFFF" ss:Bold="1"/>
   <Interior ss:Color="#4338CA" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="TitleStyle">
   <Alignment ss:Horizontal="Left" ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="16" ss:Color="#1E1B4B" ss:Bold="1"/>
  </Style>
  <Style ss:ID="SubtitleStyle">
   <Alignment ss:Horizontal="Left" ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="11" ss:Color="#64748B" ss:Italic="1"/>
  </Style>
  <Style ss:ID="CellStyle">
   <Alignment ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#1E293B"/>
  </Style>
  <Style ss:ID="CenterCell">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#1E293B"/>
  </Style>
  <Style ss:ID="GroupCell">
   <Alignment ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#4338CA" ss:Bold="1"/>
   <Interior ss:Color="#EEF2FF" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="MethodGET">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#047857" ss:Bold="1"/>
   <Interior ss:Color="#ECFDF5" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="MethodPOST">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#1D4ED8" ss:Bold="1"/>
   <Interior ss:Color="#EFF6FF" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="MethodPATCH">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#B45309" ss:Bold="1"/>
   <Interior ss:Color="#FFFBEB" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="MethodPUT">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#D97706" ss:Bold="1"/>
   <Interior ss:Color="#FEF3C7" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="MethodDELETE">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#B91C1C" ss:Bold="1"/>
   <Interior ss:Color="#FEF2F2" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="StatusDone">
   <Alignment ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#047857" ss:Bold="1"/>
   <Interior ss:Color="#F0FDF4" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="StatusWarn">
   <Alignment ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#B45309" ss:Bold="1"/>
   <Interior ss:Color="#FFFBEB" ss:Pattern="Solid"/>
  </Style>
 </Styles>
 <Worksheet ss:Name="Ceklist Integrasi Sidebar">
  <Table ss:ExpandedColumnCount="12" x:FullColumns="1" x:FullRows="1" ss:DefaultRowHeight="20">
   <Column ss:AutoFitWidth="0" ss:Width="35"/>
   <Column ss:AutoFitWidth="0" ss:Width="160"/>
   <Column ss:AutoFitWidth="0" ss:Width="140"/>
   <Column ss:AutoFitWidth="0" ss:Width="150"/>
   <Column ss:AutoFitWidth="0" ss:Width="130"/>
   <Column ss:AutoFitWidth="0" ss:Width="65"/>
   <Column ss:AutoFitWidth="0" ss:Width="260"/>
   <Column ss:AutoFitWidth="0" ss:Width="300"/>
   <Column ss:AutoFitWidth="0" ss:Width="190"/>
   <Column ss:AutoFitWidth="0" ss:Width="160"/>
   <Column ss:AutoFitWidth="0" ss:Width="110"/>
   <Column ss:AutoFitWidth="0" ss:Width="340"/>
   
   <Row ss:Height="26">
    <Cell ss:MergeAcross="11" ss:StyleID="TitleStyle"><Data ss:Type="String">DOKUMENTASI CEKLIST INTEGRASI API DEKASIMAL SESUAI SIDEBAR MY-RINGNET</Data></Cell>
   </Row>
   <Row ss:Height="18">
    <Cell ss:MergeAcross="11" ss:StyleID="SubtitleStyle"><Data ss:Type="String">Khusus Pemetaan Menu Sidebar Aktif | Total Endpoint Terpilih: 60 | Terakhir Diselaraskan: 18/8/2026</Data></Cell>
   </Row>
   <Row ss:Height="10"></Row>
   
   <Row ss:Height="26">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Grup Sidebar</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Menu Sidebar FE</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Rute URL FE</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Modul Backend</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Method</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Endpoint Path</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Deskripsi / Fungsi API</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Status API di Backend</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Status Halaman FE</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Prioritas</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Langkah Aksi Integrasi</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="GroupCell"><Data ss:Type="String">Menu Utama</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Dashboard</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">/dashboard</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Dashboard / Analytics</Data></Cell>
    <Cell ss:StyleID="MethodPOST"><Data ss:Type="String">POST</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">/api/v1/customer/list (Aggregate)</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Statistik total pelanggan aktif untuk ringkasan dashboard</Data></Cell>
    <Cell ss:StyleID="StatusDone"><Data ss:Type="String">✅ Siap Integrasi</Data></Cell>
    <Cell ss:StyleID="StatusDone"><Data ss:Type="String">Sudah Ada Halaman (Ready)</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">P1 - Utama</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Ambil total customer, business, &amp; partner untuk widget dashboard</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="GroupCell"><Data ss:Type="String">Menu Utama</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Dashboard</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">/dashboard</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Dashboard / Analytics</Data></Cell>
    <Cell ss:StyleID="MethodGET"><Data ss:Type="String">GET</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">/api/v1/broadband/list-status</Data></Cell>
    <Cell ss:StyleID="CellStyle"><Data ss:Type="String">Statistik status layanan broadband (aktif, isolir, suspend)</Data></Cell>
    <Cell ss:StyleID="StatusDone"><Data ss:Type="String">✅ Siap Integrasi</Data></Cell>
    <Cell ss:StyleID="StatusDone"><Data ss:Type="String">Sudah Ada Halaman (Ready)</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">P1 - Utama</Data></Cell>
